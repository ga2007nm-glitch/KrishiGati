{
  "name": "krishigati",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node backend/server.js",
    "prisma:generate": "prisma generate --schema=prisma.schema",
    "prisma:push": "prisma db push --skip-generate --schema=prisma.schema",
    "prisma:seed": "node --env-file=.env scripts/seed.js",
    "mongodb:init-replica": "node --env-file=.env scripts/init-mongodb-replica.js",
    "postinstall": "prisma generate --schema=prisma.schema"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "framer-motion": "^13.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mongodb": "^7.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.6",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^7.1.5"
  }
}
